# Copy to .env in the directory where you launch pnpm dsh web.
# An inherited environment variable overrides both project and ~/.dsh/.env values.
DSH_WEB_HOST=127.0.0.1
DSH_WEB_PORT=3080
DSH_WEB_OPEN_BROWSER=false

# Accept changing Cloudflare tunnel subdomains. Login with the printed ?token=...
# on the tunnel URL; a new hostname needs its own authenticated browser cookie.
DSH_WEB_TRUSTED_HOSTS=*.trycloudflare.com

# Optional: advertise the current tunnel URL in the startup link and agent context.
# DSH_WEB_PUBLIC_URL=https://your-current-tunnel.trycloudflare.com

# Optional model credential, or configure Models in the authenticated GUI.
# DEEPSEEK_API_KEY=your-api-key

# Optional listener TLS. A local Cloudflare HTTP upstream does not need these.
# DSH_WEB_TLS_CERT=/absolute/path/to/fullchain.pem
# DSH_WEB_TLS_KEY=/absolute/path/to/private-key.pem
